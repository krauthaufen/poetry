<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.0.0-rc.1</Version>
    <Description>Event-driven Path of Exile 2 combat simulator</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarnOn>3390;$(WarnOn)</WarnOn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Rng.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Mods.fs" />
    <Compile Include="Tables.fs" />
    <Compile Include="Constants.fs" />
    <Compile Include="Hit.fs" />
    <Compile Include="Ailments.fs" />
    <Compile Include="RarityData.fs" />
    <Compile Include="Encounter.fs" />
    <Compile Include="Vitals.fs" />
    <Compile Include="Sim.fs" />
    <Compile Include="Flat.fs" />
    <Compile Include="Summary.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="GameData.fs" />
    <Compile Include="StatText.fs" />
    <Compile Include="StatMap.fs" />
    <Compile Include="Gems.fs" />
    <Compile Include="Character.fs" />
    <Compile Include="Xml.fs" />
    <Compile Include="Pob.fs" />
    <Compile Include="Defence.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Behaviours.fs" />
    <Compile Include="Picture.fs" />
    <Compile Include="Setup.fs" />
    <Compile Include="Report.fs" />
  </ItemGroup>

  <!-- Fable: ship sources in the package so it can be compiled to JS. -->
  <ItemGroup>
    <Content Include="*.fsproj; **\*.fs" PackagePath="fable\" />
  </ItemGroup>

</Project>
